# BinaryAI environment template
#
# Copy to .env and fill in. NEVER commit a real .env -- it is gitignored.
# Every variable is read and validated in packages/config; nothing else in the
# codebase touches process.env. An invalid value aborts boot with a message.
#
#   cp .env.example .env

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
LOG_LEVEL=info

# -------------------------------------------------------------------- api ---
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated. A wildcard is rejected when NODE_ENV=production.
API_CORS_ORIGINS=http://localhost:3000

# The GENERAL request budget. auth_attempt, analytics, ingestion and
# paper_action have fixed budgets that configuration cannot widen -- they bound
# specific costs (password guessing, a provider's quota, a write path that takes
# row locks). See docs/security.md#rate-limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Where the counters live.
#   memory -> per process. Correct for ONE instance. With N instances the
#             effective limit is N times what is set above.
#   redis  -> shared across instances. Requires REDIS_URL.
#
# Production REFUSES memory unless RATE_LIMIT_ALLOW_IN_MEMORY=true is set
# explicitly, so a multi-instance deployment cannot silently end up enforcing a
# limit nobody chose. The opt-out exists for a genuinely single-instance
# deployment that has no other use for a Redis.
RATE_LIMIT_STORE=memory
# RATE_LIMIT_ALLOW_IN_MEMORY=false

# --------------------------------------------------------------- storage ---
# Optional in this phase: the API is stateless and reads no database.
# DATABASE_URL=postgresql://binaryai:binaryai@localhost:5432/binaryai
DATABASE_SSL=false

# Required when RATE_LIMIT_STORE=redis. Nothing else reads it.
# REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------- market data ---
# none     -> no ingestion; candles must be supplied in the request body
# coinbase -> Coinbase Exchange public market data (NO credentials required)
#
# Coinbase serves 1m, 5m, 15m, 1h and 1d candles for crypto pairs. It is
# EXCHANGE data (matched trades), not binary-options broker quote or settlement
# pricing -- see docs/market-data.md.
MARKET_DATA_PROVIDER=none

# Unused by the coinbase adapter, which calls public endpoints only.
# Reserved for keyed providers (forex/indices) added later.
# MARKET_DATA_API_KEY=
# MARKET_DATA_WS_URL=

# Age beyond which stored candles are reported STALE instead of current.
MARKET_DATA_STALENESS_SECONDS=300

# -------------------------------------------------------------- broker ---
# 'none' is the only supported value. BinaryAI cannot place orders and has no
# broker integration. These exist so the shape of the future config is clear.
BROKER_PROVIDER=none
# BROKER_API_KEY=
# BROKER_API_SECRET=

# ------------------------------------------------------------------- ai ---
# rule_based  -> local, template-based explanations (honest default)
# http_service -> a real model behind services/ai (not implemented yet)
AI_PROVIDER=rule_based
# AI_SERVICE_URL=http://localhost:8000
# AI_API_KEY=

# ----------------------------------------------------------------- auth ---
# Disabled in local development; required when NODE_ENV=production.
AUTH_ENABLED=false
# Shared bearer token for a self-hosted instance. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_API_KEY=

# --- sessions ---
# BinaryAI uses opaque server-side sessions, not JWTs, so that logout and
# account suspension take effect immediately. There is no signing secret to set.
# AUTH_SESSION_TTL_HOURS=168
# AUTH_COOKIE_NAME=binaryai_session
# Refused in production if false: a session cookie over plain HTTP is readable
# in transit. Set to false ONLY for local http://127.0.0.1 development.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=

# Open signup. Off by default -- an internet-facing instance that accidentally
# accepts public registration is worse than one needing an admin to add users.
# AUTH_ALLOW_REGISTRATION=false
# Allows the FIRST account on an empty instance to be created without an admin,
# and promotes it to admin. Closes automatically once any user exists.
# AUTH_BOOTSTRAP_ADMIN=true

# ------------------------------------------------------------ analytics ---
# Minimum settled outcomes before an accuracy rate is reported at all. Below
# this, endpoints return null and the dashboard says "not enough evidence"
# rather than showing a percentage. Lowering it does not create evidence.
# ANALYTICS_MIN_SAMPLES=30

# ------------------------------------------------------------ execution ---
# Both are refused if set to live/true: this build is demo-only by design.
# See docs/adr/0004-demo-only-execution.md.
EXECUTION_MODE=demo
ALLOW_LIVE_EXECUTION=false

# ----------------------------------------------------------- monitoring ---
MONITORING_ENABLED=false
# MONITORING_DSN=

# ------------------------------------------------------------------ web ---
# Read by the Next.js dashboard at build and request time. Public by
# definition: never put a secret in a NEXT_PUBLIC_* variable.
# Use the SAME hostname the dashboard is served from. Cookies are keyed by host
# and ignore the port, so localhost:3000 and localhost:4000 share a cookie jar --
# 127.0.0.1:4000 does not, and the session cookie would be unreachable.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Must match AUTH_COOKIE_NAME on the API. The name, not the value; not a secret.
# NEXT_PUBLIC_SESSION_COOKIE=binaryai_session

# ------------------------------------------------------- continuous workers ---
# All default to FALSE. Background loops that call an external provider must be
# an explicit choice, and development must be able to run the API without them.
#
# Ingestion needs MARKET_DATA_PROVIDER; analysis and settlement need DATABASE_URL.
MARKET_DATA_WORKER_ENABLED=false
MARKET_DATA_POLL_INTERVAL_MS=30000

LIVE_ANALYSIS_ENABLED=false
LIVE_ANALYSIS_INTERVAL_MS=15000
LIVE_ANALYSIS_SYMBOL=BTCUSD
LIVE_ANALYSIS_TIMEFRAME=1m
LIVE_ANALYSIS_STRATEGY=trend-momentum

SETTLEMENT_WORKER_ENABLED=false
SETTLEMENT_INTERVAL_MS=30000

# Housekeeping: sweeping session rows that have already expired.
#
# ON by default, unlike the other workers, because it needs no market data and
# no provider -- it only needs a database. An expired session stops
# authenticating the moment it expires, so this is RETENTION, not an
# authorisation control: it keeps the table from growing without bound and
# keeps stale credential material out of a database copy.
#
# Hourly is ample. The floor is 60s and the ceiling is 24h.
MAINTENANCE_WORKER_ENABLED=true
MAINTENANCE_INTERVAL_MS=3600000
